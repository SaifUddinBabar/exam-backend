# Examino Backend Environment Configuration Example
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/exam_db?retryWrites=true&w=majority

# Security Secrets (Generate a strong 256-bit secret for production)
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_64_characters_long
JWT_EXPIRES_IN=7d
FRONTEND_URL=https://your-frontend-domain.vercel.app

# Firebase Configuration
FIREBASE_PROJECT_ID=exam-platform-cf110

# Transactional Email (Optional - falls back to secure dev console logging if omitted)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_your_api_key_here
EMAIL_FROM="Examino Security" <security@examino.edu.bd>

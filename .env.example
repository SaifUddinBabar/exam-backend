# Examino Backend Environment Configuration Example
# Copy this file to .env and configure appropriate values for your environment.

# Server Port (Render sets this dynamically via $PORT)
PORT=5000

# Environment Mode: development | production | test
NODE_ENV=production

# MongoDB Atlas Connection String (Required)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-address>/examino?retryWrites=true&w=majority

# JWT Authentication Secret (Required for production authentication persistence)
# Generate a strong 256-bit random key: openssl rand -hex 32
JWT_ACCESS_SECRET=your_production_jwt_access_secret_hex_key_here

# JWT Expiration Period (e.g., 7d, 24h, 30m)
JWT_EXPIRES_IN=7d

# Database Backup Encryption Key (Optional - falls back to SHA256 of JWT_ACCESS_SECRET)
BACKUP_ENCRYPTION_KEY=your_backup_encryption_key_here

# Automated Backup Schedule Interval in Hours (Default: 24)
BACKUP_INTERVAL_HOURS=24

# Backup Retention Period in Days (Default: 30)
BACKUP_RETENTION_DAYS=30
